# 쇼핑쇼츠 자동화 환경변수 — 이 파일을 .env 로 복사해서 값을 채우세요.
# ⚠️ .env 는 절대 커밋하지 마세요 (.gitignore 에 등록돼 있습니다).
#     cp .env.example .env

# ─── [필수] Typecast TTS — 나레이션 음성 생성 ────────────────────────
# https://typecast.ai → 로그인 → API 키 발급
TYPECAST_API_KEY=

# ─── [선택] 유튜브 업로드 ────────────────────────────────────────────
# 업로드할 본인 채널 ID (UC... 로 시작). 오업로드 방지 가드에 쓰입니다.
# 유튜브 → 설정 → 고급 설정에서 확인
YT_CHANNEL_ID=
# 예약 공개 시각 (KST, 0~23)
YT_PUBLISH_HOUR=19
# 업로드 순서 — work/<slug> 폴더명을 쉼표로 구분. 비우면 work/ 안의 폴더를 이름순으로 씁니다.
YT_UPLOAD_ORDER=

# Google OAuth 클라이언트 (직접 업로드용 8_upload.py)
# https://console.cloud.google.com → YouTube Data API v3 사용 설정 → OAuth 클라이언트 ID(웹) 생성
# 승인된 리디렉션 URI 에 http://localhost:3000/auth/youtube/callback 추가
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── [선택] Zernio 업로드 (8_upload_zernio.py — Google OAuth 대신 사용) ─
ZERNIO_API_KEY=
ZERNIO_PROFILE_ID=
